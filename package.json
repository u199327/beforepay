{
  "name": "beforepay",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "BeforePay — know before you pay. Payment transparency checks for links, QR codes and screenshots.",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:static": "tsc -b && vite build --base ./ --outDir dist-static",
    "preview": "vite preview",
    "test": "vitest run",
    "icons": "node scripts/make-icons.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@fontsource-variable/schibsted-grotesk": "^5.3.0",
    "jsqr": "^1.4.0",
    "lucide-react": "^1.56.0",
    "punycode": "^2.3.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tldts": "^7.4.18"
  },
  "devDependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.5",
    "@types/punycode": "^2.1.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "tailwindcss": "^4.3.3",
    "typescript": "5.9",
    "vite": "^8.3.4",
    "vitest": "^5.0.4"
  }
}
