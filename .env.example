# All optional. Without them BeforePay still runs address checks, RDAP and demos.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
GOOGLE_SAFE_BROWSING_KEY=
# Optional commercial alternative. Web Risk takes precedence when both are set.
GOOGLE_WEB_RISK_KEY=
